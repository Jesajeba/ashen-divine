[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;

// Darkened screen edges for mood, plus a red tint at the edges scaled by
// danger (set from player.gd at low health).
uniform float darkness : hint_range(0.0, 1.0) = 0.45;
uniform float danger : hint_range(0.0, 1.0) = 0.0;
uniform vec4 danger_color : source_color = vec4(0.55, 0.0, 0.0, 1.0);

void fragment() {
	vec2 centered = (UV - 0.5) * vec2(1.0, 0.8);
	float edge = smoothstep(0.25, 0.75, length(centered));
	vec3 color = mix(vec3(0.0), danger_color.rgb, danger);
	float alpha = edge * mix(darkness, 0.85, danger);
	COLOR = vec4(color, alpha);
}
"

